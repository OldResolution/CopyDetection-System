# ============================================
# Copy Detection System - Database Configuration
# ============================================

# --- DATA PATHS ---
# Folder containing cleaned text files and metadata JSON
DATA_FOLDER=../Excel_Dataset

# Folder to store SQLite database and FAISS index
DB_FOLDER=../database

# --- SQLITE SETTINGS ---
# SQLite database filename (stored in DB_FOLDER)
SQLITE_DB_NAME=documents.db

# --- FAISS SETTINGS ---
# FAISS index filename (stored in DB_FOLDER)
FAISS_INDEX_NAME=faiss_index.bin
FAISS_IDS_NAME=faiss_ids.pkl

# --- EMBEDDING MODEL ---
# SentenceTransformer model name (from HuggingFace)
# Options: all-MiniLM-L6-v2 (fast), all-mpnet-base-v2 (accurate)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- CHUNKING PARAMETERS ---
# Size of each text chunk in characters
CHUNK_SIZE=500

# Overlap between chunks in characters
CHUNK_OVERLAP=50

# --- PROCESSING ---
# Skip documents that already exist in database
SKIP_EXISTING=true
